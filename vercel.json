{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.mereb.cloud"
        }
      ],
      "destination": "/docs/index.html"
    },
    {
      "source": "/manual/:path*",
      "has": [
        {
          "type": "host",
          "value": "docs.mereb.cloud"
        }
      ],
      "destination": "/docs/manual/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "docs.mereb.cloud"
        }
      ],
      "destination": "/docs/api/:path*"
    },
    {
      "source": "/((?!assets/|docs/|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "docs.mereb.cloud"
        }
      ],
      "destination": "/docs/index.html"
    },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/", "destination": "/docs/index.html" },
    { "source": "/docs/:path*", "destination": "/docs/:path*" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/llms-full.txt" }
  ]
}
